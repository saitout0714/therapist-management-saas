{
  "regions": ["hnd1"],
  "functions": {
    "app/api/**/*": {
      "memory": 3008,
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-urgent",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sync-daily",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/news-drafts",
      "schedule": "*/5 * * * *"
    }
  ]
}
